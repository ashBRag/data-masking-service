# Environment Configuration Example
# Copy to .env.<environment> (e.g. .env.development) and fill in real values.
#
# Shared infra values (Postgres, AWS/LocalStack, ...) come from the infra
# stack's own .env - this file intentionally does NOT duplicate them. The
# var names below match that .env exactly (POSTGRES_*, AWS_* if using
# LocalStack); docker-compose.yml loads that infra .env alongside this one
# (infra's .env first, then this file, so anything set here wins on
# conflict).
# Exception:
#  - POSTGRES_DB: set explicitly below to this app's own dedicated database,
#    overriding infra's shared default.

# Application Settings
APP_ENV=development
DEBUG=true
PROJECT_NAME="Data Masking Service"
VERSION=1.0.0
DESCRIPTION="Masks sensitive fields in an XML document and uploads the result to S3"

# API Settings
API_V1_STR=/api/v1

# CORS Settings
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# JWT Settings
JWT_SECRET_KEY="your-jwt-secret-key"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# Database Settings (Postgres) - this app's own database, not infra's shared default
POSTGRES_DB=data-masking-service

# Rate Limiting Settings
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# --- Masked-document storage (POST /api/v1/mask, via libs/aws.S3Client) ---
# Works against any S3-compatible endpoint. Two common setups:
#  - LocalStack (infra stack's own .env already sets these - AWS_REGION,
#    AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_ENDPOINT_URL): leave all
#    four unset here and only set S3_BUCKET.
#  - Supabase Storage's S3-compatible API: set all four explicitly below -
#    AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY are a Supabase Storage access
#    key pair (Project Settings > Storage > S3 Access Keys), NOT your
#    Supabase project's anon/service_role key.
S3_BUCKET=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
# S3_PRESIGNED_URL_EXPIRY_SECONDS=604800

# --- Inbound document fetch (POST /api/v1/mask fetches `document_url` itself) ---
# DOCUMENT_FETCH_MAX_BYTES=104857600
# DOCUMENT_FETCH_TIMEOUT_SECONDS=30
# DOCUMENT_FETCH_ALLOWED_SCHEMES=https
